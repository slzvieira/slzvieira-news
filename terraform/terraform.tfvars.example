# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit it if it contains account-specific values.

aws_region      = "us-east-1"
domain_name     = "api.slzvieira.com"
route53_zone_id = "REPLACE_WITH_YOUR_HOSTED_ZONE_ID"
image_tag       = "latest"
